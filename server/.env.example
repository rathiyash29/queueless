# Copy this file to  server/.env  and fill in YOUR OWN values.
# Never commit the real .env file to GitHub.

PORT=3000

# MySQL connection (use the user/password you set up when installing MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=queueless

# Secret used to sign login tokens (JWT). Use a long random text.
JWT_SECRET=change_this_to_a_long_random_text

# The first admin account, created by:  npm run seed
ADMIN_NAME=Admin
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=choose_a_strong_admin_password
